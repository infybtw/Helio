# Production routing. TRAEFIK_NETWORK must be the external Docker network used by
# the already running Traefik instance. TRAEFIK_CERTRESOLVER is its TLS resolver.
DOMAIN=bot.example.com
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Docker image tag published by GitHub Actions. Use a release tag in production.
HELIO_IMAGE_TAG=latest

# Telegram Bot Configuration
# Required: Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: Public URL where Telegram will send updates (e.g., https://yourdomain.com/webhook)
WEBHOOK_URL=

# Required: Secret token for webhook verification.
WEBHOOK_SECRET=

# Optional: Local path for the webhook endpoint (default: /webhook)
# This should match the path in WEBHOOK_URL
WEBHOOK_PATH=/webhook

# Optional: Port to listen on (default: 8080)
PORT=8080

# Voice recognizer configuration. Set device=cuda and compute type=float16
# when an NVIDIA GPU is available.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Number of CPU cores allocated to a transcription. Use 0 for CTranslate2's default.
WHISPER_CPU_THREADS=4
# Optional: CPU cores the voice_recognizer container may use (Docker limit).
VOICE_RECOGNIZER_CPUS=2
STT_MAX_UPLOAD_BYTES=26214400

# Optional: JetStream server used for voice jobs and transcription results.
# Use nats://nats:4222 in Docker Compose, or nats://localhost:4222 for local processes.
NATS_URL=nats://nats:4222

# Optional: Comma-separated list of update types to receive
# Default: message,channel_post,edited_message,edited_channel_post
ALLOWED_UPDATES=message,channel_post,edited_message,edited_channel_post,my_chat_member

# Optional: Log level (debug, info, warn, error) (default: info)
LOG_LEVEL=info

# Required: Secret key used to sign dashboard session cookies.
# Generate a strong random value, e.g. with: openssl rand -base64 32
SESSION_SECRET=

# Required: Origin of the dashboard frontend for CORS (e.g. http://localhost:3000 or https://yourdomain.com).
DASHBOARD_ORIGIN=https://bot.example.com

# Optional: URL to redirect users to after Telegram auth succeeds (default: /dashboard).
DASHBOARD_URL=/dashboard

# Optional: Session lifetime in seconds (default: 604800 = 7 days).
SESSION_MAX_AGE=604800

# Optional: Set session cookie Secure flag. Enable in production (default: true).
COOKIE_SECURE=true

# Optional: SameSite cookie policy: lax, strict, none (default: lax).
COOKIE_SAME_SITE=lax

# Optional: Cookie domain. Leave empty for host-only cookies.
# Set to a shared parent domain (e.g. .example.com) if dashboard and backend run on different subdomains.
COOKIE_DOMAIN=

# Required: Telegram OIDC credentials from @BotFather (Bot Settings > Login Widget).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Required: OIDC redirect URI registered in @BotFather (e.g. https://yourdomain.com/api/auth/telegram/oidc/callback).
# For local development expose the backend via ngrok and use the HTTPS callback URL.
OIDC_REDIRECT_URI=https://bot.example.com/api/auth/telegram/oidc/callback

# Optional: OIDC scopes separated by spaces (default: openid profile).
# Available: openid, profile, phone, telegram:bot_access
OIDC_SCOPES=openid profile

# Required: Public dashboard/API origin, routed by Traefik.
NUXT_PUBLIC_API_BASE_URL=https://bot.example.com

# Required: Postgres credentials for Docker Compose.
POSTGRES_USER=heliobot
POSTGRES_PASSWORD=
POSTGRES_DB=heliobot

# Required: URL-encode POSTGRES_PASSWORD here if it contains URL-reserved characters.
DATABASE_URL=postgres://heliobot:change-me@postgres:5432/heliobot?sslmode=disable
